rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    // Profiles: anyone signed in can read (to show display names on the
    // leaderboard and prediction lists); you may only write your own.
    match /users/{uid} {
      allow read: if signedIn();
      allow create, update: if signedIn() && request.auth.uid == uid;
      allow delete: if false;
    }

    // Predictions: one document per player. Everyone signed in can read every
    // prediction (the competition is fully transparent). You may only write
    // your own document, and the uid inside must match yours.
    match /predictions/{uid} {
      allow read: if signedIn();
      allow create, update: if signedIn()
        && request.auth.uid == uid
        && request.resource.data.uid == uid;
      allow delete: if false;
    }

    // Matches: world-readable, written only by the server (admin SDK bypasses
    // these rules). Clients can never write match data.
    match /matches/{id} {
      allow read: if true;
      allow write: if false;
    }

    // Match detail (stats, line-ups, commentary): world-readable, server-written.
    match /details/{id} {
      allow read: if true;
      allow write: if false;
    }

    // Tournament metadata: world-readable, server-written.
    match /meta/{doc} {
      allow read: if true;
      allow write: if false;
    }
  }
}
