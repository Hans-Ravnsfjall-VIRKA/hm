# ---------------------------------------------------------------------------
# VIRKA Tippi — environment
# Copy this file to .env.local and fill in the values. .env.local is gitignored.
# ---------------------------------------------------------------------------

# --- Firebase web config (Project settings -> General -> Your apps -> SDK) ---
# These are PUBLIC by design (they identify the project, they are not secrets);
# real protection comes from Firestore security rules + Authentication.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# ---------------------------------------------------------------------------
# The values below are used ONLY by scripts/sync.mjs (server side / CI).
# Never expose these to the browser. Do NOT prefix them with VITE_.
# ---------------------------------------------------------------------------

# API-Football key (https://www.api-football.com/ -> Dashboard)
APIFOOTBALL_KEY=

# League + season overrides (defaults: 1 / 2026)
# LEAGUE_ID=1
# SEASON=2026

# For LOCAL sync: path to your Firebase service-account JSON file.
# (In CI we use FIREBASE_SERVICE_ACCOUNT, a base64 blob, instead.)
# GOOGLE_APPLICATION_CREDENTIALS=./service-account.json
